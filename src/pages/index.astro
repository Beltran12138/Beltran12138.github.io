---
import Base from '../layouts/Base.astro';
import { person, themes, projects } from '../data/profile';
import { getCollection } from 'astro:content';

const entries = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const sections = themes.map((t) => ({
  ...t,
  // 有精选就只列精选，没有精选的主题列全部
  posts: ((all) => (all.some((e) => e.data.featured) ? all.filter((e) => e.data.featured) : all))(
    entries.filter((e) => e.data.theme === t.id)
  ),
  work: projects.filter((p) => p.theme === t.id),
}));
---

<Base>
  <h1>{person.name}</h1>
  <p class="lede">{person.tagline}</p>
  <p>
    Evidence gates for trading agents, evaluation harnesses, and essays on what language models
    can and cannot represent. Product and research at HighBlock, Hong Kong.
    When I get something wrong, it goes on the <a href="/corrections">corrections</a> page.
  </p>

  {sections.map((s) => (
    <section>
      <h2>{s.label}</h2>
      <p class="muted">{s.blurb}</p>
      <ul class="cards">
        {s.posts.map((e) => (
          <li>
            <a href={`/writing/${e.id}`}>
              <span class="entry-title">{e.data.title}</span>
              <span class="kind">{e.data.featured ? 'Essay' : 'Archive'} &middot; {e.data.pubDate.getFullYear()}</span>
            </a>
          </li>
        ))}
        {s.work.map((p) => (
          <li>
            <a href={p.url}>
              <span class="entry-title">{p.name}</span>
              <span class="small muted">{p.summary}</span>
              <span class="kind">Code</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <p class="small"><a href="/writing">All writing</a> &middot; <a href="/projects">Projects</a> &middot; <a href="/cv">CV</a></p>
</Base>
