---
import Base from '../layouts/Base.astro';
import PostRow from '../components/PostRow.astro';
import { person, themes, projects } from '../data/profile';
import { getCollection } from 'astro:content';

const entries = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const sections = themes.map((t) => ({
  ...t,
  // 有精选就只列精选，没有精选的主题列全部
  posts: ((all) => (all.some((e) => e.data.featured) ? all.filter((e) => e.data.featured) : all))(
    entries.filter((e) => e.data.theme === t.id)
  ),
  work: projects.filter((p) => p.theme === t.id),
}));

// 首屏展示一条真实更正：取精选文章里第一条带原句和新句的。
const specimen = entries
  .filter((e) => e.data.featured)
  .flatMap((e) => e.data.corrections.filter((c) => c.was && c.now).map((c) => ({ e, c })))[0];
const total = entries.reduce((n, e) => n + e.data.corrections.length, 0);
---

<Base>
  <div class="hero">
    <div>
      <h1>{person.tagline}</h1>
      <p>
        Mine included. I build evidence gates for trading agents and evaluation harnesses, and write
        about what language models can and cannot represent. Product and research at HighBlock, Hong Kong.
      </p>
    </div>
    {specimen && (
      <figure class="slip">
        <blockquote>
          <del>{specimen.c.was}</del>
          <ins><span>{specimen.c.now}</span></ins>
        </blockquote>
        <figcaption class="ui">
          From <a href={`/writing/${specimen.e.id}`}>{specimen.e.data.title}</a>,
          one of <a href="/corrections">{total} corrections</a> so far.
        </figcaption>
      </figure>
    )}
  </div>

  {sections.map((s) => (
    <section class="theme">
      <header>
        <h2>{s.label}</h2>
        <p>{s.blurb}</p>
      </header>
      <div>
        {s.posts.length > 0 && (
          <ul class="rows">{s.posts.map((e) => <li><PostRow entry={e} /></li>)}</ul>
        )}
        {s.work.length > 0 && (
          <>
            {s.posts.length > 0 && <p class="code-label ui">Code</p>}
            <ul class="rows">
              {s.work.map((p) => (
                <li>
                  <a class="row code" href={p.url}>
                    <span>
                      <span class="title">{p.name}</span>
                      <span class="desc">{p.summary}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}
      </div>
    </section>
  ))}

  <p class="ui"><a href="/writing">All writing</a>, including the archive</p>
</Base>
