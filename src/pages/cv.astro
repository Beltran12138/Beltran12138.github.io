---
import Base from '../layouts/Base.astro';
import { person, roles, education } from '../data/profile';

const period = (start: string, end: string | null) => `${start} to ${end ?? 'now'}`;
---

<Base title="CV" description={`${person.name}, curriculum vitae. ${person.tagline}`}>
  <h1>Curriculum vitae</h1>
  <p class="lede">{person.tagline}</p>
  <p class="ui no-print"><button type="button" onclick="print()">Print or save as PDF</button></p>

  <section class="section">
    <h2>Experience</h2>
    <div style="margin-top:1rem">
      {roles.map((role) => (
        <div class="role">
          <span class="dates ui">{period(role.start, role.end)}</span>
          <div>
            <h3>{role.org}</h3>
            <span class="ui muted">{role.title}, {role.location}{role.orgNote && <> ({role.orgNote})</>}</span>
            <ul>{role.bullets.map((b) => <li>{b}</li>)}</ul>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <h2>Education</h2>
    <div style="margin-top:1rem">
      {education.map((ed) => (
        <div class="role">
          <span class="dates ui">{period(ed.start, ed.end)}</span>
          <div>
            <h3>{ed.school}</h3>
            <span class="ui muted">{ed.degree}, {ed.location}</span>
            {ed.notes.length > 0 && <ul>{ed.notes.map((n) => <li>{n}</li>)}</ul>}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <h2>Contact</h2>
    <p><a href={`mailto:${person.email}`}>{person.email}</a></p>
  </section>
</Base>
