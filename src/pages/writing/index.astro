---
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const groups = [
  { label: 'Essays', note: 'Rechecked since publication. Each page states what was and was not covered.', items: entries.filter((e) => e.data.featured) },
  { label: 'Archive', note: 'Earlier essays. Those marked with corrections were rechecked and await a rewrite; the rest are as published and not rechecked.', items: entries.filter((e) => !e.data.featured) },
];
---

<Base title="Writing" description="Essays on how language models represent the world, and on when a number deserves trust.">
  <h1>Writing</h1>
  <p class="lede">Most of these began as Chinese essays and were rewritten in English.</p>

  {groups.map((g) => (
    <section class="section">
      <h2>{g.label}</h2>
      <p class="muted">{g.note}</p>
      <ul class="rows">{g.items.map((entry) => <li><PostRow entry={entry} /></li>)}</ul>
    </section>
  ))}
</Base>
