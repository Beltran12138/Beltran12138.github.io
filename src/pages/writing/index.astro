---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = (d: Date) => d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short' });
---

<Base title="Writing" description="Research notes on crypto market structure, Hong Kong virtual-asset regulation, and AI agents.">
  <h1>Writing</h1>
  <p class="lede">
    Research notes on crypto market structure, Hong Kong virtual-asset regulation,
    and applying AI agents to both.
  </p>

  {entries.length === 0 ? (
    <p class="muted">Nothing published yet.</p>
  ) : (
    <ul class="entries">
      {entries.map((entry) => (
        <li>
          <a class="entry-title" href={`/writing/${entry.id}`}>{entry.data.title}</a>
          <div class="entry-meta">
            {fmt(entry.data.pubDate)}
            {entry.data.tags.length > 0 && <> &middot; {entry.data.tags.join(', ')}</>}
          </div>
          <p class="small muted" style="margin:.35rem 0 0">{entry.data.summary}</p>
        </li>
      ))}
    </ul>
  )}
</Base>
