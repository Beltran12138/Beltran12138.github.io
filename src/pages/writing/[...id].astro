---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('writing', ({ data }) => !data.draft);
  const ids = new Set(entries.map((e) => e.id));
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: {
      entry,
      // 只有当对面那篇确实存在且已发布时才互指 —— 指向一个不存在的 hreflang 比不指更糟。
      sibling:
        entry.data.translationOf && ids.has(entry.data.translationOf)
          ? entries.find((e) => e.id === entry.data.translationOf)!
          : null,
    },
  }));
}

const { entry, sibling } = Astro.props;
const { Content } = await render(entry);

const zh = entry.data.lang === 'zh';

// 抓正文第一张图作为社交卡片图。原创图表比通用卡片好得多 ——
// 它直接告诉人这篇有实质内容，不是又一篇没插图的观点文。
const firstImage = entry.body?.match(/!\[[^\]]*\]\((\/figures\/[^)\s]+)\)/)?.[1];

const fmt = (d: Date) =>
  d.toLocaleDateString(zh ? 'zh-CN' : 'en-GB', {
    year: 'numeric',
    month: zh ? 'numeric' : 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
---

<Base
  title={entry.data.title}
  description={entry.data.summary}
  lang={entry.data.lang}
  article={{
    headline: entry.data.title,
    datePublished: entry.data.pubDate.toISOString(),
    dateModified: entry.data.updatedDate?.toISOString(),
    keywords: entry.data.tags,
    image: firstImage,
  }}
  alternates={sibling ? [{ lang: sibling.data.lang, href: `/writing/${sibling.id}` }] : []}
>
  <article>
    <h1>{entry.data.title}</h1>
    <p class="entry-meta">
      {fmt(entry.data.pubDate)}
      {entry.data.updatedDate && <> &middot; updated {fmt(entry.data.updatedDate)}</>}
      {entry.data.tags.length > 0 && <> &middot; {entry.data.tags.join(', ')}</>}
      {sibling && (
        <> &middot; <a href={`/writing/${sibling.id}`}>{zh ? 'English version' : '中文版'}</a></>
      )}
    </p>

    {(entry.data.confidence || entry.data.falsifier || entry.data.checked) && (
      <dl class="claim">
        {entry.data.confidence && <><dt>Confidence</dt><dd>{entry.data.confidence}</dd></>}
        {entry.data.falsifier && <><dt>Would change my mind</dt><dd>{entry.data.falsifier}</dd></>}
        {entry.data.checked && <><dt>Last checked</dt><dd>{fmt(entry.data.checked)}{entry.data.checkedScope && <>. {entry.data.checkedScope}</>}</dd></>}
      </dl>
    )}
    {entry.data.corrections.length > 0 && (
      <details class="claim" open>
        <summary>Corrections ({entry.data.corrections.length})</summary>
        <ul>{entry.data.corrections.map((c) => <li>{c.text}</li>)}</ul>
      </details>
    )}
    {!entry.data.featured && (
      <p class="small muted">{entry.data.checked ? 'Archived: the corrections above weaken the main argument. Awaiting a rewrite.' : 'Archived essay, kept as published. Not rechecked since.'}</p>
    )}

    <Content />

    {entry.data.originalSource && (
      <p class="small muted">{zh ? '出处：' : 'Source: '}{entry.data.originalSource}</p>
    )}
  </article>

  <p class="small"><a href="/writing">&larr; All writing</a></p>
</Base>
