---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('writing', ({ data }) => !data.draft);
  const ids = new Set(entries.map((e) => e.id));
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: {
      entry,
      // 只有当对面那篇确实存在且已发布时才互指 —— 指向一个不存在的 hreflang 比不指更糟。
      sibling:
        entry.data.translationOf && ids.has(entry.data.translationOf)
          ? entries.find((e) => e.id === entry.data.translationOf)!
          : null,
    },
  }));
}

const { entry, sibling } = Astro.props;
const { Content } = await render(entry);

const zh = entry.data.lang === 'zh';

const fmt = (d: Date) =>
  d.toLocaleDateString(zh ? 'zh-CN' : 'en-GB', {
    year: 'numeric',
    month: zh ? 'numeric' : 'long',
    day: 'numeric',
  });
---

<Base
  title={entry.data.title}
  description={entry.data.summary}
  lang={entry.data.lang}
  article={{
    headline: entry.data.title,
    datePublished: entry.data.pubDate.toISOString(),
    dateModified: entry.data.updatedDate?.toISOString(),
  }}
  alternates={sibling ? [{ lang: sibling.data.lang, href: `/writing/${sibling.id}` }] : []}
>
  <article>
    <h1>{entry.data.title}</h1>
    <p class="entry-meta">
      {fmt(entry.data.pubDate)}
      {entry.data.updatedDate && <> &middot; updated {fmt(entry.data.updatedDate)}</>}
      {entry.data.tags.length > 0 && <> &middot; {entry.data.tags.join(', ')}</>}
      {sibling && (
        <> &middot; <a href={`/writing/${sibling.id}`}>{zh ? 'English version' : '中文版'}</a></>
      )}
    </p>

    <Content />

    {entry.data.originalSource && (
      <p class="small muted">{zh ? '出处：' : 'Source: '}{entry.data.originalSource}</p>
    )}
  </article>

  <p class="small"><a href="/writing">&larr; All writing</a></p>
</Base>
