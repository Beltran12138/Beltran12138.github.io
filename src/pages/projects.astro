---
import Base from '../layouts/Base.astro';
import { projects, themes } from '../data/profile';

const groups = [...themes.map((t) => ({ id: t.id as string, label: t.label })), { id: 'tools', label: 'Markets and tools' }]
  .map((g) => ({ ...g, items: projects.filter((p) => p.theme === g.id) }));
---

<Base title="Projects" description="Open-source evidence gates, evaluation harnesses and research artifacts.">
  <h1>Projects</h1>
  <p class="lede">Full list on <a href="https://github.com/Beltran12138">GitHub</a>.</p>

  <div class="section">
    {groups.map(({ label, items }) => items.length > 0 && (
      <section class="theme">
        <header><h2>{label}</h2></header>
        <ul class="rows">
          {items.map((p) => (
            <li>
              <a class="row code" href={p.url}>
                <span>
                  <span class="title">{p.name}</span>
                  <span class="desc">{p.summary}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
